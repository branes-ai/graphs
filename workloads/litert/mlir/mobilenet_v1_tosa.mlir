    %101 = tosa.conv2d %100, %23, %22 {dilation = array<i64: 1, 1>, pad = array<i64: 0, 0, 0, 0>, stride = array<i64: 1, 1>} : (tensor<?x14x14x512xf32>, tensor<512x1x1x512xf32>, tensor<512xf32>) -> tensor<?x14x14x512xf32>

    %103 = tosa.depthwise_conv2d %102, %1, %21 {dilation = array<i64: 1, 1>, pad = array<i64: 0, 1, 0, 1>, stride = array<i64: 2, 2>} : (tensor<?x14x14x512xf32>, tensor<3x3x512x1xf32>, tensor<512xf32>) -> tensor<?x7x7x512xf32>
    %104 = tosa.clamp %103 {max_fp = 6.000000e+00 : f32, max_int = 6 : i64, min_fp = 0.000000e+00 : f32, min_int = 0 : i64} : (tensor<?x7x7x512xf32>) -> tensor<?x7x7x512xf32>
    %105 = tosa.conv2d %104, %20, %19 {dilation = array<i64: 1, 1>, pad = array<i64: 0, 0, 0, 0>, stride = array<i64: 1, 1>} : (tensor<?x7x7x512xf32>, tensor<1024x1x1x512xf32>, tensor<1024xf32>) -> tensor<?x7x7x1024xf32>
    %106 = tosa.clamp %105 {max_fp = 6.000000e+00 : f32, max_int = 6 : i64, min_fp = 0.000000e+00 : f32, min_int = 0 : i64} : (tensor<?x7x7x1024xf32>) -> tensor<?x7x7x1024xf32>
    %107 = tosa.depthwise_conv2d %106, %0, %18 {dilation = array<i64: 1, 1>, pad = array<i64: 1, 1, 1, 1>, stride = array<i64: 1, 1>} : (tensor<?x7x7x1024xf32>, tensor<3x3x1024x1xf32>, tensor<1024xf32>) -> tensor<?x7x7x1024xf32>
    %108 = tosa.clamp %107 {max_fp = 6.000000e+00 : f32, max_int = 6 : i64, min_fp = 0.000000e+00 : f32, min_int = 0 : i64} : (tensor<?x7x7x1024xf32>) -> tensor<?x7x7x1024xf32>
    %109 = tosa.conv2d %108, %17, %16 {dilation = array<i64: 1, 1>, pad = array<i64: 0, 0, 0, 0>, stride = array<i64: 1, 1>} : (tensor<?x7x7x1024xf32>, tensor<1024x1x1x1024xf32>, tensor<1024xf32>) -> tensor<?x7x7x1024xf32>
    %110 = tosa.clamp %109 {max_fp = 6.000000e+00 : f32, max_int = 6 : i64, min_fp = 0.000000e+00 : f32, min_int = 0 : i64} : (tensor<?x7x7x1024xf32>) -> tensor<?x7x7x1024xf32>
    %111 = tosa.reduce_sum %110 {axis = 1 : i32} : (tensor<?x7x7x1024xf32>) -> tensor<?x1x7x1024xf32>
    %112 = tosa.reduce_sum %111 {axis = 2 : i32} : (tensor<?x1x7x1024xf32>) -> tensor<?x1x1x1024xf32>
    %113 = tosa.mul %112, %13 {shift = 0 : i8} : (tensor<?x1x1x1024xf32>, tensor<1x1x1x1xf32>) -> tensor<?x1x1x1024xf32>
    %114 = tosa.conv2d %113, %15, %14 {dilation = array<i64: 1, 1>, pad = array<i64: 0, 0, 0, 0>, stride = array<i64: 1, 1>} : (tensor<?x1x1x1024xf32>, tensor<1000x1x1x1024xf32>, tensor<1000xf32>) -> tensor<?x1x1x1000xf32>
    %115 = tosa.reshape %114 {new_shape = array<i64: -1, 1000>} : (tensor<?x1x1x1000xf32>) -> tensor<?x1000xf32>
    %116 = tosa.reduce_max %115 {axis = 1 : i32} : (tensor<?x1000xf32>) -> tensor<?x1xf32>
    %117 = tosa.sub %115, %116 : (tensor<?x1000xf32>, tensor<?x1xf32>) -> tensor<?x1000xf32>
    %118 = tosa.exp %117 : (tensor<?x1000xf32>) -> tensor<?x1000xf32>
    %119 = tosa.reduce_sum %118 {axis = 1 : i32} : (tensor<?x1000xf32>) -> tensor<?x1xf32>
    %120 = tosa.reciprocal %119 : (tensor<?x1xf32>) -> tensor<?x1xf32>
    %121 = tosa.mul %118, %120 {shift = 0 : i8} : (tensor<?x1000xf32>, tensor<?x1xf32>) -> tensor<?x1000xf32>
    return %121 : tensor<?x1000xf32>
  }
}


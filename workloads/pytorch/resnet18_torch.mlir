    %88 = torch.operator "onnx.GlobalAveragePool"(%87) : (!torch.vtensor<[?,512,7,7],f32>) -> !torch.vtensor<[?,512,1,1],f32> 
    %89 = torch.operator "onnx.Flatten"(%88) {torch.onnx.axis = 1 : si64} : (!torch.vtensor<[?,512,1,1],f32>) -> !torch.vtensor<[?,512],f32> 
